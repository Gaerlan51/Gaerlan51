# Supabase (Singapore region, ap-southeast-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Cron jobs and migrations ONLY — never in a request handler
# serving a signed-in user. Enforced by `npm run guard:service-role`.
SUPABASE_SERVICE_ROLE_KEY=

# Reminder delivery
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
RESEND_API_KEY=
REMINDER_FROM_EMAIL=

APP_TIMEZONE=Asia/Manila

# Local Postgres used by the RLS integration tests (npm run test:db)
TEST_DATABASE_URL=postgres://postgres@localhost:5433/clinic_test
